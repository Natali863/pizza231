<?php

namespace App\Services;

class ValidateOrderData
{
    private array $errors = [];

    public function validate(array $data): bool
    {
        $this->errors = [];

        // ФИО
        if (empty($data['full_name'])) {
            $this->errors['full_name'] = 'Поле "Полное имя" обязательно для заполнения.';
        } elseif (mb_strlen($data['full_name']) < 3) {
            $this->errors['full_name'] = 'Поле "Полное имя" должно содержать не менее 3 символов.';
        }

        // Адрес
        if (empty($data['address'])) {
            $this->errors['address'] = 'Поле "Адрес" обязательно для заполнения.';
        } elseif (mb_strlen($data['address']) < 10) {
            $this->errors['address'] = 'Поле "Адрес" должно содержать не менее 10 символов.';
        } elseif (mb_strlen($data['address']) > 200) {
            $this->errors['address'] = 'Поле "Адрес" не должно превышать 200 символов.';
        }

        // Телефон
        if (empty($data['phone'])) {
            $this->errors['phone'] = 'Поле "Телефон" обязательно для заполнения.';
        } else {
            $filteredPhone = filter_var($data['phone'], FILTER_SANITIZE_NUMBER_INT);
            // Дополнительная проверка, что остались только цифры и плюс (если он был первым)
            if (!preg_match('/^\+?\d+$/', $filteredPhone)) {
                 $this->errors['phone'] = 'Поле "Телефон" содержит недопустимые символы.';
            }
            // Можно добавить проверку на минимальное/максимальное количество цифр, если необходимо
        }

        // Email
        if (empty($data['email'])) {
            $this->errors['email'] = 'Поле "Email" обязательно для заполнения.';
        } elseif (!filter_var($data['email'], FILTER_VALIDATE_EMAIL)) {
            $this->errors['email'] = 'Поле "Email" заполнено некорректно.';
        }

        return empty($this->errors);
    }

    public function getErrors(): array
    {
        return $this->errors;
    }
}
